model Product {
    id Int @id @default(autoincrement())

    tradeId Int @map("trade_id")
    // relation
    
    prodCatId Int @map("prod_cat_id")
    prodCat ProductCategory @relation(references: [id], fields: [prodCatId])

    name String
    sort Int
    volume Float
    block Int
    sapCode Int? @map("sap_code")
    barCode Int? @map("bar_code")
    ikpu Int?
    
    taraId Int @map("tara_id")
    // relation

    time DateTime
    code Int?
    active Boolean @default(true)
    weight Float

    csProduct Int? @map("cs_product")
    csId Int @map("cd_id")
    // relation
    groupId Int @map("group_id")
    group ProductGroup @relation(references: [id], fields: [groupId])
    
    subCatId Int @map("sub_cat_id")
    subCat ProductSubCategory @relation(references: [id], fields: [subCatId])
    
    caseTypeId Int? @map("case_type_id")
    // relation
    csCatId Int @map("cd_cat_id")
    // relation
    csRate Int @map("cs_rate")
    // relation

    isMml Boolean @default(false) @map("is_mml")
    
    unitId Int @map("unit_id")
    // relation

    pack Int
    segment Int
    brand Int
    producer Int

    isOur Boolean @default(true) @map("is_our")
    isLocal Boolean @default(true) @map("is_local")

    prices Price[]
    bonuses Bonus[]
    discounts Discount[]
    defectDetails DefectDetail[]
    replaceDetails ReplaceDetail[]
    bonusOrders BonusOrder[]
    bonusOrderDetails BonusOrderDetail[]
    storeDetails StoreDetail[]
    purchaseDetails PurchaseDetail[]
    purchaseRefundDetails PurchaseRefundDetail[]
    productCatGroups ProductCatGroup[]
    correctors Corrector[]
    excretions Excretion[]

    @@map("product")
}

