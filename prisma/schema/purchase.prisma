model Purchase {
  id Int @id @default(autoincrement())

  code        Int
  count       Int
  status      Int
  debt        Int
  numPurchase Int @map("num_purchase")

  summa   Float
  comment String

  shippedId Int @map("shipped_id")
  // shipped   Shipped @relation(fields: [shippedId], references: [id])

  filialId Int @map("filial_id")
  // filial   Filial @relation(fields: [filialId], references: [id])

  priceTypeId Int       @map("price_type_id")
  priceType   PriceType @relation(fields: [priceTypeId], references: [id])

  storeId Int   @map("store_id")
  store   Store @relation(fields: [storeId], references: [id])

  date      DateTime
  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  detail PurchaseDetail?

  PurchaseRefundDetail PurchaseRefundDetail[]
}

model PurchaseDetail {
  id Int @id @default(autoincrement())

  count  Int
  price  Float
  sum    Float
  volume Float

  isActive Boolean @default(true) @map("is_active")

  purchaseId Int      @unique @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  prodCatId  Int             @map("prod_cat_id")
  productCat ProductCategory @relation(fields: [prodCatId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  unitId Int @map("unit_id")
  // unit       Unit     @relation(fields: [unitId], references: [id])

  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model PurchaseRefund {
  id Int @id @default(autoincrement())

  code    Int
  count   Int
  status  Int
  type    Int
  debt    Int
  sum     Float
  comment String

  isActive Boolean @default(true) @map("is_active")

  filialId Int @map("filial_id")
  // filial     Filial   @relation(fields: [filialId], references: [id])

  priceTypeId Int       @map("price_type_id")
  priceType   PriceType @relation(fields: [priceTypeId], references: [id])

  shippedId Int @map("shipped_id")
  // shipped     Shipped  @relation(fields: [shippedId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  storeId Int   @map("store_id")
  store   Store @relation(fields: [storeId], references: [id])

  date      DateTime
  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model PurchaseRefundDetail {
  id Int @id @default(autoincrement())

  count  Int
  price  Float
  summa  Float
  volume Float

  isActive Boolean @default(true) @map("is_active")

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  prodCatId  Int             @map("prod_cat_id")
  productCat ProductCategory @relation(fields: [prodCatId], references: [id])

  purchaseId Int      @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  unitId Int @map("unit_id")
  // unit       Unit     @relation(fields: [unitId], references: [id])

  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
