model PaymentMethod {
  id Int @id @default(autoincrement())

  name  String
  code  String
  title String

  warehouses Warehouse[] @relation("warehouse_payment_method")

  priceTypes PriceType[]

  @@map("payment_method")
}

enum PaymentType {
  CASH
  TRANSFER
}

model PriceType {
  id Int @id @default(autoincrement())

  sort    Int?
  name    String
  code    String?
  comment String? @db.Text

  type DealType

  handEdit  Boolean @default(false) @map("hand_edit")
  forClient Boolean @default(false) @map("for_client")

  payMethodId Int           @map("valyuta_id")
  payMethod   PaymentMethod @relation(fields: [payMethodId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  //filial Int
  // dealerPrice Int @default(0) @map("dealer_price")

  isActive Boolean @default(true) @map("is_active")

  prices          Price[]
  orders          Order[]
  defect          Defect[]
  bonuses         Bonus[]
  replaces        Replace[]
  purchases       Purchase[]
  purchaseRefunds PurchaseRefund[]
  discounts       Discount[]
  reciepts        Reciept[]

  @@map("price_type")
}

enum DealType {
  SALE
  PURCHASE
}

model Price {
  id Int @id @default(autoincrement())

  price   Float
  code    String
  codeDoc Int    @map("code_doc")

  isActive Boolean @default(true) @map("is_active")

  typeId Int       @map("type_id")
  type   PriceType @relation(fields: [typeId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // orders Order[]

  @@map("price")
}
