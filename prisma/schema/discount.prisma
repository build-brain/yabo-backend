model DiscountManual {
  id Int @id @default(autoincrement())

  name    String
  comment String? @db.Text

  discount Float

  isActive Boolean @default(true) @map("is_active")

  agentId Int   @map("agent_id")
  agent   Agent @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Discount {
  id Int @id @default(autoincrement())

  name    String
  comment String? @db.Text

  parent Int
  value  Float
  skidka Float
  budget Float @default(0)

  dateFrom DateTime @map("date_from")
  dateTo   DateTime @map("date_to")

  isPublic Boolean @default(true) @map("is_public")
  isActive Boolean @default(false) @map("is_active")

  priceTypeId Int       @map("price_type")
  priceType   PriceType @relation(fields: [priceTypeId], references: [id])

  discountTypeId Int @map("discount_type_id")
  // relation

  productId Int     @map("prod_id")
  product   Product @relation(fields: [productId], references: [id])

  clientCatId Int            @map("client_cat_id")
  clientCat   ClientCategory @relation(fields: [clientCatId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients Client[]
}
