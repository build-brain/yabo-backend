model DiscountManual {
  id Int @id @default(autoincrement())

  name     String
  comment  String
  discount Float
  time     DateTime

  active Boolean @default(true)

  agentId Int   @map("agent_id")
  agent   Agent @relation(fields: [agentId], references: [id])
}

model Discount {
  id Int @id @default(autoincrement())

  name    String
  comment String
  value   Float
  skidka  Float
  parent  Int
  budget  Float    @default(0)
  date    DateTime

  dateFrom DateTime @map("date_from")
  dateTo   DateTime @map("date_to")

  isPublic Boolean @default(true) @map("is_public")
  isActive Boolean @default(false) @map("is_active")

  priceType Int @map("price_type")
  // relation

  discountTypeId Int @map("discount_type_id")
  // relation

  productId Int @map("prod_id")
  // relation

  clientCatId Int @map("client_cat_id")
  // relation

  currencyId Int @map("currency_id")
  // relation

  Client Client[]
}
