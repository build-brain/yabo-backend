model User {
  id Int @id @default(autoincrement())

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  middleName String? @map("middle_name")

  email String?
  phone String?

  login    String @unique
  password String

  role Role
  code Int
  pay  Int

  // codeId Int @map("code_id")
  // relation

  // chatId Int @map("chat_id")
  // relation

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin         Admin?
  agent         Agent?
  operator      Operator?
  mashier       Cashier?
  partner       Partner?
  supervisor    Supervisor?
  manager       Manager?
  expeditor     Expeditor?
  merchandaiser Merchandaiser?
  warehouseman  Warehouseman?

  transactions ClientTransaction[]
  Order        Order[]

  @@map("user")
}

enum Role {
  ADMIN
  AGENT
  OPERATOR
  CASHIER
  PARTNER
  SUPERVISOR
  MANAGER
  EXPEDITOR
  MERCHANDISER
  WAREHOUSEMAN
}

model Admin {
  id Int @id @default(autoincrement())

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin")
}

model Agent {
  id Int @id @default(autoincrement())

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  filter Int
  code   Int

  address      String
  passportCopy String @map("passport_copy")

  dateBirth  DateTime @map("date_birth")
  firstVisit DateTime @map("first_visit")

  audit      Int
  cashbox    Int
  vanSelling Int @map("van_selling")

  warehouses Warehouse[] @relation("warehouse_agent")

  bonuses         Bonus[]
  defects         Defect[]
  replaces        Replace[]
  transactions    ClientTransaction[]
  discountManuals DiscountManual[]
  visitings       Visiting[]
  Order           Order[]

  @@map("agent")
}

