model PriceType {
  id Int @id @default(autoincrement())

  name    String
  type    String
  code    String?
  comment String? @db.Text
  sort    Int?

  handEdit  Boolean @default(false) @map("hand_edit")
  forClient Boolean @default(false) @map("for_client")

  payMethodId Int           @map("valyuta_id")
  payMethod   PaymentMethod @relation(fields: [payMethodId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  //filial Int
  // dealerPrice Int @default(0) @map("dealer_price")

  isActive Boolean @default(true) @map("is_active")

  prices          Price[]
  orders          Order[]
  defect          Defect[]
  bonuses         Bonus[]
  replaces        Replace[]
  purchases       Purchase[]
  purchaseRefunds PurchaseRefund[]

  Discount Discount[]

  Reciept Reciept[]
}

model Price {
  id Int @id @default(autoincrement())

  price    Float
  currency String
  code     Int
  date     DateTime
  codeDoc  Int      @map("code_doc")

  isActive Boolean @default(true) @map("is_active")

  typeId Int       @map("type_id")
  type   PriceType @relation(fields: [typeId], references: [id])

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  orders Order[]
}