model Currency {
  id Int @id @default(autoincrement())

  title String
  name  String
  code  String

  cssClass String @map("css_class")

  codeId Int? @map("code_id")

  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id])

  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems            OrderItem[]
  bonuses               Bonus[]
  bonusOrders           BonusOrder[]
  discounts             Discount[]
  replaces              Replace[]
  cashboxes             Cashbox[]
  consumptions          Consumption[]
  transactions          ClientTransaction[]
  purchaseDetails       PurchaseDetail[]
  purchaseRefunds       PurchaseRefund[]
  purchaseRefundDetails PurchaseRefundDetail[]
  priceTypes            PriceType[]
  Price                 Price[]

  @@map("currency")
}

model Unit {
  id Int @id @default(autoincrement())

  name  String
  title String
  code  String?

  isActive Boolean @default(true) @map("is_active")

  orderItems           OrderItem[]
  products             Product[]
  productCategories    ProductCategory[]
  productSubCategories ProductSubCategory[]
  productCatGroups     ProductCatGroup[]

  @@map("unit")
}

model Region {
  id Int @id @default(autoincrement())

  name String
  code String

  territories Territory[]
  currencies  Currency[]
  clients     Client[]

  @@map("region")
}

model Territory {
  id Int @id @default(autoincrement())

  name String
  code Int?
  sort Int?

  lat Float @default(0)
  lon Float @default(0)

  isActive Boolean @default(true) @map("is_active")
  inReport Boolean @default(true) @map("in_report")

  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id])

  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expeditors Expeditor[]
  clients    Client[]
  orders     Order[]
  orderItems OrderItem[]
  bonuses    Bonus[]
  defects    Defect[]
  replaces   Replace[]

  @@map("territory")
}

model Producer {
  id Int @id @default(autoincrement())

  name    String
  country String?
  sort    Int?

  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("producer")
}

model Brand {
  id Int @id @default(autoincrement())

  name String
  sort Int?

  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("brand")
}

model Segment {
  id Int @id @default(autoincrement())

  name String
  sort Int?

  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("segment")
}

model Visiting {
  id Int @id @default(autoincrement())

  day      Int
  sort     Int
  weekType Int @default(0) @map("week_type")

  isActive Boolean @default(true) @map("is_active")

  agentId Int   @map("agent_id")
  agent   Agent @relation(fields: [agentId], references: [id])

  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("visiting")
}

model Cashbox {
  id Int @id @default(autoincrement())

  name String

  isActive Boolean @default(true) @map("is_active")

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumptions      Consumption[]
  ClientTransaction ClientTransaction[]

  @@map("cashbox")
}

model Consumption {
  id Int @id @default(autoincrement())

  sum     Float
  comment String

  isActive Boolean @default(true) @map("is_active")

  type Int

  // catParentId Int             @map("cat_parent_id")
  // catParent   ProductCategory @relation(fields: [catChildId], references: [id])

  // catChildId Int             @map("cat_child_id")
  // catChild   ProductCategory @relation(fields: [catChildId], references: [id])

  currencyId Int      @map("currency_id")
  currency   Currency @relation(fields: [currencyId], references: [id])

  cashboxId Int     @map("cashbox_id")
  cashbox   Cashbox @relation(fields: [cashboxId], references: [id])

  shipTransId Int @map("ship_trans_id")
  // relation

  dispId Int @map("disp_id")
  // relation

  date      DateTime
  time      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("consumption")
}

model Corrector {
  id Int @id @default(autoincrement())

  name    String
  comment String
  count   Int
  fact    Int
  type    Int
  parent  Int
  price   Float
  armor   Float

  isAvailable Boolean @default(true) @map("is_available")

  productId Int      @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])

  storeId Int   @map("store_id")
  store   Store @relation(fields: [storeId], references: [id])

  date      DateTime
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("corrector")
}

model Excretion {
  id Int @id @default(autoincrement())

  code        Int
  date        DateTime
  comment     String
  count       Int
  responsible Boolean

  storeId Int   @map("store_id")
  store   Store @relation(fields: [storeId], references: [id])

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  prodCatId Int             @map("prod_cat_id")
  prodCat   ProductCategory @relation(fields: [prodCatId], references: [id])

  timestamp  DateTime
  parentTime DateTime @map("parent_time")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("excretion")
}

model RefusalReason {
  id Int @id @default(autoincrement())

  name    String
  comment String?

  isActive Boolean @default(true) @map("is_active")

  @@map("refusal_reason")
}

model ReturnReason {
  id Int @id @default(autoincrement())

  name    String
  comment String?

  isActive Boolean @default(true) @map("is_active")

  @@map("return_reason")
}

model PhotoreportCategory {
  id Int @id @default(autoincrement())

  name String
  sort Int?

  isActive Boolean @default(true) @map("is_active")

  @@map("photoreport_category")
}

model InventoryType {
  id Int @id @default(autoincrement())

  name  String
  type  String?
  code  String?
  title String?
  sort  Int?

  isActive Boolean @default(true) @map("is_active")

  groupId Int
  group   InventoryGroup @relation(fields: [groupId], references: [id])

  @@map("inventory_type")
}

model InventoryGroup {
  id Int @id @default(autoincrement())

  name String

  isActive Boolean @default(true) @map("is_active")

  types InventoryType[]

  @@map("inventory_group")
}

model TaskType {
  id Int @id @default(autoincrement())

  name String
  code String?

  @@map("task_type")
}

model TradeDirection {
  id Int @id @default(autoincrement())

  name String
  code String?

  @@map("trade_direction")
}

model DistributionChannel {
  id Int @id @default(autoincrement())

  name String
  code String?

  @@map("distribution_channel")
}

model CaseType {
  id Int @id @default(autoincrement())

  name      String
  code      String?
  shortName String?

  isActive Boolean @default(true) @map("is_active")

  @@map("case_type")
}

model KnowledgeBaseType {
  id Int @id @default(autoincrement())

  name  String
  roles Role[]

  isActive Boolean @default(true) @map("is_active")

  knowledgeBases KnowledgeBase[]

  @@map("knowledge_base_type")
}

model KnowledgeBase {
  id Int @id @default(autoincrement())

  title   String
  content String @db.Text

  isActive Boolean @default(true) @map("is_active")

  typeId Int               @map("type_id")
  type   KnowledgeBaseType @relation(fields: [typeId], references: [id])

  roles Role[]

  @@map("knowledge_base")
}

model Container {
  id Int @id @default(autoincrement())

  name String
  sort Int?

  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("container")
}
